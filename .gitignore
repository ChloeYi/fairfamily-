# Environment variables (API keys, Firebase config — NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/

# Production build
build/

# Android (regenerate with: npx cap add android)
android/

# iOS (regenerate with: npx cap add ios)
ios/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# MacOS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code internal files
.claude/
.mcp.json

# Vercel site build (npm run build:site)
dist/
.vercel
.env*

# Old copies of the app build (contain an exposed key) — never commit
website/app.html
website/static/
website/asset-manifest.json

{
  "framework": null,
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.fairfamily.site" }],
      "status": 308,
      "headers": { "Location": "https://fairfamily.site/$1" }
    },
    { "handle": "filesystem" },
    { "src": "/app(?:/.*)?", "dest": "/app/index.html" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
